+def top_fraction_mean(anomaly_maps, fraction=0.01):
+    assert 0 < fraction <= 1
+    flat_scores = np.asarray(anomaly_maps).reshape(anomaly_maps.shape[0], -1)
+    top_count = max(1, int(np.ceil(flat_scores.shape[1] * fraction)))
+    pooled_scores = np.empty(flat_scores.shape[0], dtype=np.float64)
+    for index, row in enumerate(flat_scores):
+        split_index = row.size - top_count
+        pooled_scores[index] = np.partition(row, split_index)[split_index:].mean()
+    return pooled_scores, top_count
+
